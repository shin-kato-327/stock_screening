# Copy to .env and fill in real values. .env is gitignored.
# Bootstrap: scripts/bootstrap_airflow.sh reads this and runs `airflow variables set` / `connections add`.

# --- API credentials ---
# EDINET API key (https://disclosure2.edinet-fsa.go.jp/)
EDINET_KEY=

# JQUANTS v2 x-api-key. Get it from the dashboard at
# https://jpx-jquants.com/ — paid tiers include the historical depth
# this project relies on.
JQUANTS_API_KEY=

# IBKR Flex Web Service — read-only positions sync. See
# scripts/sync_ibkr_positions.py header for portal setup steps.
# Generate token at: Performance & Reports → Flex Queries → Flex Web
# Service. Create a Flex Query (Activity type, Open Positions section)
# and paste its Query ID here. Token expires every ~6 months.
IBKR_FLEX_TOKEN=
IBKR_POSITIONS_QUERY_ID=

# --- Postgres (financial_data DB) ---
POSTGRES_USER=root
POSTGRES_PASSWORD=
POSTGRES_DB=financial_data
POSTGRES_HOST=pgdatabase
POSTGRES_PORT=5432

# --- Airflow ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_UID=50000

# --- Backfill / sim parameters (also set as Airflow Variables) ---
# Defaults to 365 days ago if unset.
BACKFILL_START_DATE=

INITIAL_CAPITAL=10000000
MAX_POSITIONS=20
TRANSACTION_COST_BPS=10
BENCHMARK_TICKER=1306

# --- Signal alerts (outbound only) ---
# See signal/SETUP.md for one-time bot linking via QR scan.
# Sender = the Signal phone number registered on the server-side bot
# (linked as a secondary device on your account).
SIGNAL_SENDER_NUMBER=
# Recipients (comma-separated, E.164 with leading +). Usually just yourself.
SIGNAL_RECIPIENT_NUMBERS=
# Where airflow can reach signal-cli-rest-api. From inside the airflow
# docker network, http://signal-api:8080 if on shared financial_network.
SIGNAL_API_URL=http://signal-api:8080
# Day-2 toggle: enable Claude Code post-mortem diagnosis on DAG failure.
# Leave false until `claude` CLI is installed + OAuth'd on the host.
SIGNAL_DIAGNOSIS_ENABLED=false

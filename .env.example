# Copy to .env and fill in real values. .env is gitignored.
# Bootstrap: scripts/bootstrap_airflow.sh reads this and runs `airflow variables set` / `connections add`.

# --- API credentials ---
# EDINET API key (https://disclosure2.edinet-fsa.go.jp/)
EDINET_KEY=

# JQUANTS refresh token from the portal (paid tier).
# Client exchanges this for a 24h ID token; no email/password needed.
JQUANTS_REFRESH_TOKEN=

# --- Postgres (financial_data DB) ---
POSTGRES_USER=root
POSTGRES_PASSWORD=
POSTGRES_DB=financial_data
POSTGRES_HOST=pgdatabase
POSTGRES_PORT=5432

# --- Airflow ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_UID=50000

# --- Backfill / sim parameters (also set as Airflow Variables) ---
# Defaults to 365 days ago if unset.
BACKFILL_START_DATE=

INITIAL_CAPITAL=10000000
MAX_POSITIONS=20
TRANSACTION_COST_BPS=10
BENCHMARK_TICKER=1306

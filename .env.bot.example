# ============================================================================
# Telegram Q&A Bot — env file for systemd/screening-bot.service
# ============================================================================
#
# Copy to `.env.bot` and fill in real values.
# Loaded ONLY by the screening-bot systemd unit; the airflow stack
# and analysis scripts continue to use `.env`.
#
# IMPORTANT: do NOT set bare POSTGRES_USER/POSTGRES_PASSWORD here. If
# the bot's import chain ever transitively reaches db.get_engine(), it
# should fail loudly rather than silently connect as bot_readonly. We
# namespace the bot's DB creds with BOT_ to prevent that collision —
# runner.sh re-exports them as PGPASSWORD only at the psql boundary.

# --- Telegram (reuse existing alerts bot token, per design) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Postgres connection for the bot's qa-psql shim ---
BOT_POSTGRES_HOST=localhost
BOT_POSTGRES_PORT=5433
BOT_POSTGRES_DB=financial_data
BOT_POSTGRES_USER=bot_readonly
# Generate a strong value:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# Set this BEFORE running `alembic upgrade head` for migration 0012, then
# paste the same value here so the bot can connect.
BOT_POSTGRES_PASSWORD=

# --- Bot tuning ---
# Per-day question cap (counts /q messages accepted by the listener).
MAX_PER_DAY=10

# systemd reduces PATH; list every dir we need.
PATH=/usr/local/bin:/usr/bin:/bin:/home/shinkato/.local/bin
